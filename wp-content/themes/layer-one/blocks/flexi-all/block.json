{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "layerone/flexi-all",
	"title": "Collectibles: all figures",
	"category": "layer-one",
	"icon": "grid-view",
	"description": "Series filter chips and a grid of every figure.",
	"keywords": ["flexi", "collectibles", "figures", "grid", "layer one"],
	"textdomain": "layer-one",
	"attributes": {
		"title": { "type": "string", "default": "All {figures}" },
		"accent": { "type": "string", "default": "figures" },
		"text": { "type": "string", "default": "Filter by series, then tap any figure for a closer look." }
	},
	"supports": { "html": false, "align": false, "multiple": false },
	"editorScript": "file:./editor.js",
	"viewScript": "layerone-flexi-app",
	"style": [ "layerone-flexi", "layerone-flexi2" ],
	"render": "file:./render.php"
}
