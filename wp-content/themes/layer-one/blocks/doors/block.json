{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "layerone/doors",
	"title": "Three doors",
	"category": "layer-one",
	"icon": "columns",
	"description": "Heading, three expanding image cards that link to the product lines, and a row of trust badges.",
	"keywords": ["doors", "cards", "lines", "layer one"],
	"textdomain": "layer-one",
	"attributes": {
		"heading": { "type": "string", "default": "Printed layer by layer," },
		"headingAccent": { "type": "string", "default": "for you." },
		"intro": { "type": "string", "default": "Three things we make on our own print farm in NCR. Pick where you want to start." },
		"doors": { "type": "array", "default": [] },
		"trust": {
			"type": "array",
			"default": [
				{ "bold": "Free shipping", "text": "over ₹999" },
				{ "bold": "Partial COD", "text": "· ₹100 to confirm" },
				{ "bold": "Printed to order", "text": "in PLA+" },
				{ "bold": "7-day reprint", "text": "if damaged" }
			]
		}
	},
	"supports": { "html": false, "align": false },
	"editorScript": "file:./editor.js",
	"editorStyle": "file:./editor.css",
	"viewScript": "file:./view.js",
	"style": "layerone-landing2",
	"render": "file:./render.php"
}
