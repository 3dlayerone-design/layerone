{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "layerone/newsletter",
	"title": "Drop list signup",
	"category": "layer-one",
	"icon": "email-alt",
	"description": "Newsletter box. Emails are saved under Tools > Drop list.",
	"keywords": ["newsletter", "subscribe", "drop list", "layer one"],
	"textdomain": "layer-one",
	"attributes": {
		"heading": { "type": "string", "default": "Join the drop list for" },
		"headingAccent": { "type": "string", "default": "new series" },
		"tail": { "type": "string", "default": "" },
		"placeholder": { "type": "string", "default": "Your email address" },
		"button": { "type": "string", "default": "Subscribe" },
		"thanks": { "type": "string", "default": "Thanks for subscribing!" }
	},
	"supports": { "html": false, "align": false },
	"editorScript": "file:./editor.js",
	"viewScript": "file:./view.js",
	"style": "layerone-landing2",
	"render": "file:./render.php"
}
